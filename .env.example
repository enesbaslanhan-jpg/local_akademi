# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
BETA_MODE=false
SHUTDOWN_TIMEOUT_MS=10000

# JWT — GENERATE A STRONG SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 bytes (256 bits) required for production/beta.
# JWT_SECRET=
JWT_EXPIRES_IN=8h

# Database — two options:
#
# Option A: PostgreSQL (default — requires `docker compose up -d postgres`)
#   Host backend:   DATABASE_URL="postgresql://localakademi:localakademi@127.0.0.1:5432/localakademi?schema=public"
#   Container backend: DATABASE_URL="postgresql://localakademi:localakademi@postgres:5432/localakademi?schema=public"
#   The hostname differs because containers resolve each other by service name,
#   while host processes connect via localhost / 127.0.0.1.
DATABASE_URL="postgresql://localakademi:localakademi@127.0.0.1:5432/localakademi?schema=public"
#

# --- Production: least-privilege database roles -------------------------
# The application must NOT connect as the bootstrap superuser. Create the
# runtime role once:
#   APP_DB_PASSWORD="<strong>" npx tsx scripts/setup-app-db-role.ts
#
# Then the container uses two connections (see docker-entrypoint.sh):
#   DATABASE_URL          -> localakademi_app  (DML only: SELECT/INSERT/UPDATE/DELETE)
#   MIGRATE_DATABASE_URL  -> localakademi      (owner; needed for prisma migrate deploy)
#
# docker-compose builds both from DB_PASSWORD and APP_DB_PASSWORD, and now
# REQUIRES them — the old "localakademi" fallback password is gone.
# DB_PASSWORD=
# APP_DB_PASSWORD=

# --- Tests --------------------------------------------------------------
# `npm test` runs `prisma db push --accept-data-loss`. The pretest guard
# refuses any database whose name does not end in "_test". If your shell has
# DATABASE_URL set to a real database, point tests explicitly:
# TEST_DATABASE_URL="postgresql://localakademi:localakademi@127.0.0.1:5432/localakademi_test?schema=public"
# Option B: SQLite (no external service needed, legacy)
# DATABASE_URL="file:./dev.db"

# CORS — comma-separated origins for production/beta
#   Example: CORS_ORIGIN=https://beta.localakademi.com,http://localhost:5173
#   Default (development): allows all origins
CORS_ORIGIN=

# --- Ters vekil (reverse proxy) ------------------------------------------
# IP tabanlı hız sınırlarının kime uygulandığını belirler. 22 uç nokta buna
# bağlı: giriş (10/dk), kayıt (5/saat), şifre sıfırlama (3/saat)...
#
# TANIMSIZ (varsayılan): X-Forwarded-For YOK SAYILIR, soket adresi kullanılır.
#   Uygulama doğrudan internete bakıyorsa DOĞRU seçim budur.
#
# Nginx/Caddy/Traefik ARKASINDAYSANIZ mutlaka ayarlayın:
#   TRUST_PROXY=1                → tek vekil
#   TRUST_PROXY=10.0.0.0/8       → güvenilecek adres aralığı
#
# Ayarlamazsanız tüm istekler vekilin IP'sinden geliyormuş gibi görünür ve
# tek kullanıcı herkesin kotasını tüketebilir.
#
# TRUST_PROXY=true KULLANMAYIN: başlığa koşulsuz güvenir, saldırgan her
# istekte başlığı değiştirerek tüm hız sınırlarını aşabilir.
# TRUST_PROXY=

# --- E-posta gönderimi ---------------------------------------------------
# Şifre sıfırlama ve e-posta doğrulama BUNA BAĞLIDIR.
#
# RESEND_API_KEY tanımlı DEĞİLSE: e-postalar gerçekten gönderilmez, sunucu
# loguna yazılır. Geliştirme ve testler bu yolda çalışır.
# ÜRETİMDE tanımsızsa sunucu açılışta hata verir — şifre sıfırlamanın sessizce
# çalışmaması, kullanıcının hesabına erişimini kaybetmesi demektir.
#
# Kurulum: resend.com hesabı aç, alan adının DNS'ine SPF/DKIM kaydı ekle.
# RESEND_API_KEY=
#
# Gönderen adresi. Doğrulanmış alan adında olmalı.
#   Örnek: MAIL_FROM="LocalKarar <no-reply@localkarar.com>"
# MAIL_FROM=
#
# E-postalardaki bağlantıların temel adresi (sıfırlama bağlantısı vb.).
#   Örnek: APP_PUBLIC_URL=https://localkarar.com
# APP_PUBLIC_URL=
#
# KVKK NOTU: Resend ABD merkezlidir; kullanıcının e-posta adresi ve adı yurt
# dışına aktarılır. Bu, aydınlatma metninde açıkça belirtilmelidir. Aktarımı
# istemiyorsanız yalnız src/services/mailer.ts içindeki `resendGonder`
# değiştirilir; çağıran kodun hiçbiri değişmez.

# AI Mentor (NVIDIA API) — required for AI Mentor feature
# API key al: https://build.nvidia.com/
# NVIDIA_API_KEY=

# AI Mentor model (NVIDIA'da hosted, OpenAI-compatible)
# Varsayılan: minimaxai/minimax-m2.7
# Alternatif: deepseek-ai/deepseek-v3.2 (mevcutsa)
# NVIDIA_MODEL=minimaxai/minimax-m2.7

# AI sağlayıcısı: auto | ollama | nvidia | openai | deepseek | omniroute
# Yerel kurulum için önerilen değer: ollama
# auto: Ollama yapılandırılmışsa onu; değilse anahtarı bulunan OmniRoute,
#       NVIDIA, OpenAI veya DeepSeek sağlayıcısını seçer.
AI_PROVIDER=ollama

# Ana Mentor için yerel Ollama (yalnızca loopback adresi kabul edilir).
# auto modu bu değişkenlerden biri tanımlıysa Ollama'yı bulut sağlayıcılarından
# önce seçer.
OLLAMA_API_URL=http://127.0.0.1:11434/v1/chat/completions
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT=120000

# NVIDIA (isteğe bağlı bulut sağlayıcısı)
# NVIDIA_API_KEY=
# NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5

# DeepSeek (OpenAI-compatible)
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash

# OmniRoute (OpenAI-compatible yerel gateway/agregatör)
# Ancak localhost:20128'de çalışanların da .env'de OMNIROUTE_API_KEY
# ile anahtar tanımlaması beklenir (key örneğe yazılmaz).
OMNIROUTE_BASE_URL=http://localhost:20128/v1
# OMNIROUTE_API_KEY=
# OMNIROUTE_MODEL=auto/best-free

# Haber otomasyonu AI sağlayıcısı/modeli (analyzer bu değerleri kullanır)
# NEWS_AI_PROVIDER=omniroute
# NEWS_AI_MODEL=auto/best-free

# AI Mentor sağlayıcısı/modeli (MENTOR_AI_* tanımlıysa AI_PROVIDER'ı ezer)
# MENTOR_AI_PROVIDER=omniroute
# MENTOR_AI_MODEL=auto/best-free

# AI Gateway yapılandırması
# AI_REQUEST_TIMEOUT_MS=60000
# AI_MAX_OUTPUT_TOKENS=2048
# AI_REVIEW_GATE_ENABLED=true
# AI_REVIEW_MAX_OUTPUT_CHARS=20000

# AI Reviewer (varsayılan kapalı; Aşama 2 yalnız shadow/observation)
# AI_REVIEWER_ENABLED=false
# Aşama 2'de enforce değeri istense bile gateway kullanıcı yanıtını değiştirmez.
# AI_REVIEWER_MODE=shadow
# disclaimer_only yalnız tamamlanmış insan denetiminden sonra iki ayarla açılır:
# AI_REVIEWER_MODE=disclaimer_only
# AI_REVIEWER_DISCLAIMER_ROLLOUT_APPROVED=false
# Pilot için isteklerin deterministik olarak %10'unu değerlendirir (0–1).
# AI_REVIEWER_SAMPLE_RATE=0.10
# AI_REVIEWER_TIMEOUT_MS=8000
# AI_REVIEWER_MAX_DRAFT_CHARS=20000
# AI_REVIEWER_MAX_EVIDENCE_CHARS=5400
# Reviewer sağlayıcısı: inherit (ana AI sağlayıcısı) | ollama (yerel)
# AI_REVIEWER_PROVIDER=inherit
# Yerel reviewer örneği:
# AI_REVIEWER_PROVIDER=ollama
# AI_REVIEWER_MODEL=qwen3:4b-instruct
# OLLAMA_API_URL=http://127.0.0.1:11434/v1/chat/completions
# OLLAMA_MODEL=qwen3:4b-instruct
# Yerel reviewer kuyruğu (kullanıcı yanıtını bekletmez)
# AI_REVIEWER_QUEUE_CONCURRENCY=1
# AI_REVIEWER_QUEUE_MAX_PENDING=20
# AI_REVIEWER_HEALTH_TIMEOUT_MS=1500
# İçerik saklamayan kalıcı operasyonel metrikler
# AI_REVIEWER_PERSIST_METRICS=true
# AI_REVIEWER_METRICS_RETENTION_DAYS=30
# AI_REVIEWER_PILOT_MIN_SAMPLES=200
# AI_REVIEWER_PILOT_MIN_AVAILABILITY=0.98
# AI_REVIEWER_PILOT_MAX_P95_MS=60000
# Canlı örnek incelendikten sonra yalnız etiket saklayan insan denetimi.
# AI_REVIEWER_HUMAN_AUDIT_MIN_SAMPLES=20
# AI_REVIEWER_HUMAN_AUDIT_APPROVED=false

# RAG retrieval: lexical (varsayılan) | hybrid (lexical + yerel embedding)
# RAG_RETRIEVAL_MODE=lexical
# RAG_EMBEDDING_MODEL=nomic-embed-text
# RAG_EMBEDDING_TIMEOUT_MS=30000
# RAG_SEMANTIC_MIN_SIMILARITY=0.35
# RAG_SEMANTIC_CANDIDATE_LIMIT=500
# Yeni yayımlanan KO'ları istekten bağımsız yerel kuyrukta indeksler.
# RAG_AUTO_EMBEDDING_ENABLED=false
# RAG_AUTO_EMBEDDING_MAX_PENDING=20

# User memory API: AI Mentor'un kullanıcıdan öğrendiklerini saklaması ve yönetmesi.
# Varsayılan olarak açıktır; yalnızca false verilirse kapatılır.
ENABLE_MEMORY_API=true

# AI quiz generation is admin-only and always creates a draft.
# AI_QUIZ_GENERATOR_ENABLED=false
# AI_QUIZ_GENERATOR_MODEL=qwen3:4b-instruct
# AI_QUIZ_GENERATOR_TIMEOUT_MS=60000

# Official update summarizer is admin-only, local and draft-only.
# AI_OFFICIAL_SUMMARIZER_ENABLED=false
# AI_OFFICIAL_SUMMARIZER_MODEL=qwen3:4b-instruct
# AI_OFFICIAL_SUMMARIZER_TIMEOUT_MS=60000

# Quiz ve resmî özet üretimi için ortak yerel AI kuyruğu.
# LOCAL_AI_QUEUE_CONCURRENCY=1
# LOCAL_AI_QUEUE_MAX_PENDING=5
# DATABASE_BACKUP_RETENTION_COUNT=10
# LOG_ROTATION_MAX_BYTES=5242880
# LOG_ROTATION_KEEP_COUNT=10

# REZERVED / KULLANIM DIŞI:
# MENTOR_REVIEWER_ENABLED — kullanılmıyor

# Belge yükleme: kullanıcı başına toplam kota (bayt). Varsayılan: 104857600 (100 MB)
# DOCUMENT_USER_QUOTA_BYTES=104857600

# Beta mode: set to "invite_only" to disable public registration
# BETA_MODE=invite_only

# Admin bootstrap — ilk admin hesabini olusturmak icin calistirin:
#   npm run admin:bootstrap
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_PASSWORD=

# Admin reset password — mevcut admin parolasini degistirmek icin calistirin:
#   npm run admin:reset-password
# ADMIN_RESET_EMAIL=
# ADMIN_RESET_PASSWORD=
# ADMIN_RESET_CONFIRM=
# Phase 8 product experience flags
FEATURE_DECISION_CHECKS_ENABLED=true
FEATURE_PRACTICAL_CARDS_ENABLED=false
FEATURE_PERSONALIZED_FEED_ENABLED=true
FEATURE_LEARNING_PROGRESS_ENABLED=true
FEATURE_CONTEXTUAL_MENTOR_ENABLED=true
VITE_FF_DECISION_CHECKS=true
VITE_FF_PRACTICAL_CARDS=false
VITE_FF_PERSONALIZED_FEED=true
VITE_FF_LEARNING_PROGRESS=true
VITE_FF_CONTEXTUAL_MENTOR=true

# Phase 8 legacy learning rollback flags (normal learner experience: OFF)
FEATURE_LEGACY_QUIZ_ENABLED=false
FEATURE_LEGACY_FLASHCARDS_ENABLED=false
VITE_FF_LEGACY_QUIZ=false
VITE_FF_LEGACY_FLASHCARDS=false

# --- Pazaryeri entegrasyonlari (provider-bagimsiz) ------------------------
#
# Credential sifreleme (AES-256-GCM). Anahtar DB'de ve repoda SAKLANMAZ.
# Uretimde MUTLAKA ayri bir anahtar tanimlayin (32 bayt; hex onerilir):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Tanimli degilse anahtar JWT_SECRET'ten turetilir (uretimde uyari verir).
# INTEGRATION_ENCRYPTION_KEY=
#
# Zamanlanmis pazaryeri esitlemesi. Varsayilan KAPALI: worker kendiliginden
# baslamaz, yalniz manuel sync calisir. Uretimde acmek icin 'true' yapin.
# MARKETPLACE_SYNC_ENABLED=false
# Periyot (dakika). Varsayilan 120.
# MARKETPLACE_SYNC_INTERVAL_MINUTES=120

# Pazaryeri urunleri: dusuk stok uyarisi esigi (LocalKarar tarafi).
# Provider stok verisi bu esikle karsilastirilir; deger provider'a
# gonderilmez. Varsayilan 10. Baglanti basina istek aninda da
# lowStockThreshold parametresiyle ezilebilir.
MARKETPLACE_LOW_STOCK_THRESHOLD=10

# Shopify (GraphQL Admin API 2026-07). LocalKarar Shopify Admin disinda
# calistigi icin authorization-code OAuth kullanir. Client secret yalniz
# backend env'de kalir; access token magazaya ozel AES-256-GCM saklanir.
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# SHOPIFY_OAUTH_REDIRECT_URI=https://api.example.com/integrations/shopify/oauth/callback
# FRONTEND_URL=https://app.example.com
