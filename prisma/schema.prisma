/// Oturum yenileme tokeni.
///
/// tokenVersion BURADA da tutuluyor: yenileme sirasinda kullanicinin
/// guncel surumuyle karsilastiriliyor. Boylece sifre degisimi,
/// "tum cihazlardan cik", sifre sifirlama, askiya alma ve
/// anonimlestirme -- yani tokenVersion i artiran HER yol -- acik
/// yenileme tokenlarini kendiliginden gecersiz kiliyor. Bes ayri
/// cagri yerine "yenileme tokenini de iptal et" eklenseydi, ileride
/// eklenecek altincisinin unutulmasi sessiz bir guvenlik acigi olurdu.
///
/// familyId: donus (rotation) ailesi. Kullanilmis bir token TEKRAR
/// sunulursa (usedAt dolu) bu, tokenin calindiginin isaretidir; o
/// zaman ailenin tamami iptal edilir.
model RefreshToken {
  id           String    @id @default(uuid())
  userId       Int
  tokenHash    String    @unique
  familyId     String
  tokenVersion Int
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// ==========================================
// PAZARYERI ENTEGRASYONLARI (provider-bagimsiz)
//
// Entegrasyon USER'a degil WORKSPACE'e aittir. Credential'lar
// AES-256-GCM ile sifrelenir (src/lib/crypto.ts); plaintext
// olarak HICBIR alana yazilmaz. metadata alanlari yalnizca
// provider'a ozgu, ortak semada yeri olmayan ek bilgiler
// tasir; ana finansal degerler metadata'ya GOMULMEZ.
// ==========================================

enum IntegrationProvider {
  TRENDYOL
  HEPSIBURADA
  N11
  SHOPIFY
  AMAZON
  WOOCOMMERCE
}

enum IntegrationConnectionStatus {
  PENDING
  ACTIVE
  ERROR
  DISABLED
}

enum IntegrationSyncType {
  MANUAL
  SCHEDULED
  INITIAL
}

enum IntegrationSyncRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

/// Pazaryeri siparis durumu - provider'dan normalize edilir.
/// Kaynak durumlar (orn. Trendyol "Delivered") mapper'da buraya cevrilir.
enum MarketplaceOrderStatus {
  CREATED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  PARTIALLY_RETURNED
  UNKNOWN
}

/// Pazaryeri baglantisi. Bir workspace + provider + harici hesap
/// kombinasyonu icin TEK satir vardir.
model IntegrationConnection {
  id                      String                      @id @default(uuid())
  workspaceId             String
  createdByUserId         Int
  provider                IntegrationProvider
  /// Provider tarafindaki hesap kimligi (orn. Trendyol sellerId).
  externalAccountId       String
  displayName             String?
  // Sifreli credential'lar. Anahtar DB'de ve repoda DEGIL, env'de.
  encryptedApiKey         String?
  encryptedApiSecret      String?
  encryptedAccessToken    String?
  encryptedRefreshToken   String?
  status                  IntegrationConnectionStatus @default(PENDING)
  lastSyncedAt            DateTime?
  lastSuccessfulSyncAt    DateTime?
  lastErrorCode           String?
  lastErrorAt             DateTime?
  /// Art arda basarisiz sync sayisi. Esik asilinca zamanlanmis sync
  /// atlanir (circuit breaker); manuel sync denemesi sayaci dusurur.
  consecutiveFailureCount Int                         @default(0)
  syncEnabled             Boolean                     @default(true)
  /// Baglantiye ozel periyot. Null ise env varsayilani kullanilir.
  syncIntervalMinutes     Int?
  // Bu pazaryeri odemeyi kac GUN sonra yapiyor (kullanicinin bilgisi).
  //
  // 🔴 NEDEN KULLANICIYA SORULUYOR: odeme tarihi hicbir saglayicinin
  // API'sinde yok. Gomulu bir varsayilan yanlis oldugunda SESSIZCE
  // hatali nakit tahmini uretirdi -- vade uydurmamak icin verilen
  // kararin ayni gerekcesi.
  //
  // NULL = vade yazilmaz. Kayit yine olusur ve Kayitlar'da gorunur,
  // ama takvime ve 30 gunluk tahsilat toplamina girmez.
  payoutDelayDays         Int?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  workspace BusinessWorkspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User                 @relation("IntegrationConnections", fields: [createdByUserId], references: [id])
  syncRuns  IntegrationSyncRun[]

  @@unique([workspaceId, provider, externalAccountId])
  @@index([provider, status])
  @@index([syncEnabled, lastSyncedAt])
}

/// Tek bir sync calistirmasinin kaydi. Paralel calismayi engellemek
/// icin RUNNING satiri ayni zamanda kilit gorevi gorur.
model IntegrationSyncRun {
  id               String                   @id @default(uuid())
  connectionId     String
  provider         IntegrationProvider
  syncType         IntegrationSyncType
  startedAt        DateTime                 @default(now())
  finishedAt       DateTime?
  status           IntegrationSyncRunStatus @default(RUNNING)
  recordsFetched   Int                      @default(0)
  recordsCreated   Int                      @default(0)
  recordsUpdated   Int                      @default(0)
  recordsSkipped   Int                      @default(0)
  errorCode        String?
  errorMessageSafe String?
  cursor           String?
  createdAt        DateTime                 @default(now())

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
  @@index([status, startedAt])
}

/// Pazaryeri siparisi (gercek kaynak kayit). BusinessRecord olarak
/// DEGIL, kendi tablosunda tutulur; ihtiac duyulursa ayri projection
/// katmanindan uretilir. Tutar alanlarinda Float KULLANILMAZ.
model MarketplaceOrder {
  id                  String                 @id @default(uuid())
  workspaceId         String
  provider            IntegrationProvider
  externalId          String
  externalOrderNumber String?
  externalCustomerId  String?
  /// PII minimize edildi: ad + soyadin bas harfi (orn. "Ayse K.").
  customerDisplayName String?
  currency            String                 @default("TRY")
  grossAmount         Decimal                @db.Decimal(18, 2)
  discountAmount      Decimal?               @db.Decimal(18, 2)
  /// Provider gercek komisyon TUTARI vermiyorsa null kalir;
  /// yuzdeden tahmin uydurulmaz.
  commissionAmount    Decimal?               @db.Decimal(18, 2)
  shippingAmount      Decimal?               @db.Decimal(18, 2)
  refundAmount        Decimal?               @db.Decimal(18, 2)
  taxAmount           Decimal?               @db.Decimal(18, 2)
  /// gross - discount - commission - shipping - refund. Verilerden
  /// herhangi biri yoksa null (sahte 0 ile yaniltma yasak).
  netContribution     Decimal?               @db.Decimal(18, 2)
  status              MarketplaceOrderStatus @default(UNKNOWN)
  orderDate           DateTime
  providerUpdatedAt   DateTime?
  syncedAt            DateTime               @default(now())
  metadata            Json?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  workspace BusinessWorkspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     MarketplaceOrderItem[]

  @@unique([workspaceId, provider, externalId])
  @@index([workspaceId, provider, orderDate])
  @@index([workspaceId, status])
  @@index([workspaceId, orderDate])
}

model MarketplaceOrderItem {
  id                 String   @id @default(uuid())
  orderId            String
  externalId         String?
  externalProductId  String?
  sku                String?
  barcode            String?
  title              String
  quantity           Int
  unitPrice          Decimal  @db.Decimal(18, 2)
  grossAmount        Decimal  @db.Decimal(18, 2)
  discountAmount     Decimal? @db.Decimal(18, 2)
  commissionAmount   Decimal? @db.Decimal(18, 2)
  shippingAllocation Decimal? @db.Decimal(18, 2)
  refundAmount       Decimal? @db.Decimal(18, 2)
  netContribution    Decimal? @db.Decimal(18, 2)
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  order MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model MarketplaceProduct {
  id                        String              @id @default(uuid())
  workspaceId               String
  provider                  IntegrationProvider
  externalId                String
  sku                       String?
  barcode                   String?
  title                     String
  brand                     String?
  category                  String?
  salePrice                 Decimal?            @db.Decimal(18, 2)
  listPrice                 Decimal?            @db.Decimal(18, 2)
  stockQuantity             Int?
  currency                  String?
  isActive                  Boolean             @default(true)
  /// Provider'in gercek urun gorseli (https URL). Provider saglamiyorsa
  /// null kalir; sahte resim uretilmez. Sync tarafindan yonetilir.
  imageUrl                  String?
  images                    Json?
  providerUpdatedAt         DateTime?
  syncedAt                  DateTime            @default(now())
  metadata                  Json?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  /// --- LocalKarar YEREL AYARLARI ---
  /// Bunlar isletmenin kendi notlaridir; provider sync'i bu alanlari
  /// ASLA ezmez (repository upsert update path'inde bulunmaz).
  internalNote              String?
  tags                      Json?
  lowStockThresholdOverride Int?
  isFavorite                Boolean             @default(false)

  workspace BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, externalId])
  @@index([workspaceId, isActive])
}

// ─── ABONELİK VE ÖDEME ──────────────────────────────────────────────
//
// Plan tanimlari BURADA DEGIL: `src/config/billing.ts` tek kaynak ve
// fiyatlar oradan turetiliyor. Ikinci bir dogruluk kaynagi acmak,
// ekranda gorunen fiyat ile tahsil edilen tutarin ayrismasi demek.
//
// Abonelik KULLANICI basina (urun sahibi karari): kullanici oder,
// butun isletmelerinde kullanir.

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

// Yenilemenin otomatik mi elle mi oldugu. Urun sahibi 30.08.2026'da
// OTOMATIK'e karar verdi ve yasal metinler bunu tahhut ediyor -- ama
// kayitli kartla tekrarlayan tahsilat PayTR'de AYRI bir yetki ve
// verildigi henuz teyit edilmedi. Alan bastan burada ki cevap
// degistiginde goc gerekmesin.
enum RenewalMode {
  AUTO
  MANUAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum BillingProfileType {
  INDIVIDUAL
  CORPORATE
}

/// FATURA KIMLIK BILGISI.
///
/// 🔴 Odeme calisiyordu ama fatura kesilebilecek hicbir bilgi
/// toplanmiyordu: PayTR token'ina `user_address` ve `user_phone`
/// olarak "Belirtilmedi" gidiyordu.
///
/// 🔴 KVKK -- yalniz faturanin gerektirdigi alanlar. TCKN ISTEGE
/// BAGLI (urun sahibi karari, 31.08.2026); bos birakilirsa fatura
/// nihai tuketici olarak duzenlenir. TCKN ve VKN hicbir herkese acik
/// yanitta, gunlukte ya da hata mesajinda gecmez.
///
/// ⚠️ Abonelik basina DEGIL kullanici basina: abonelik iptal edilip
/// yeniden baslatildiginda fatura bilgisi tekrar sorulmamali.
model BillingProfile {
  id        String             @id @default(uuid())
  userId    Int                @unique
  type      BillingProfileType @default(INDIVIDUAL)
  /// Bireyselde ad soyad, kurumsalda ticari unvan.
  title     String
  /// Bireysel ve istege bagli. Kurumsalda her zaman null.
  tckn      String?
  /// Kurumsalda zorunlu.
  vkn       String?
  taxOffice String?
  phone     String
  address   String
  city      String
  district  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                String             @id @default(uuid())
  userId            Int                @unique
  status            SubscriptionStatus @default(TRIALING)
  period            BillingPeriod      @default(MONTHLY)
  /// 🔴 VARSAYILAN MANUAL (01.09.2026). Otomatik yenilemeden
  /// vazgecildi: PayTR'de kayitli karttan tahsilat yalniz Direkt API
  /// + Non3D ile mumkun ve o yol kart verisini bizim sunucumuzdan
  /// gecirir. AUTO degeri enum'da KALIYOR -- yetki ileride alinirsa
  /// goc gerekmesin diye baslangictan beri oyle tasarlandi.
  renewalMode       RenewalMode        @default(MANUAL)
  currentPeriodEnd  DateTime?
  /// Iptal edildi ama donem sonuna kadar erisim suruyor (urun sahibi
  /// karari: kismi iade yok, donem sonuna kadar devam).
  cancelAtPeriodEnd Boolean            @default(false)
  canceledAt        DateTime?

  /// ⚠️ ASAGIDAKI UC ALAN BUGUN KULLANILMIYOR ve doldurulmuyor.
  ///
  /// Otomatik yenilemeden vazgecildigi icin (01.09.2026) kart HIC
  /// saklanmiyor; yasal metinler de "kartiniz saklanmaz" diyor.
  /// Sutunlar dusurulmedi cunku yikici bir goc gerektirir ve hicbir
  /// sey kazandirmaz; yetki ileride alinirsa hazir duruyorlar.
  ///
  /// 🔴 BURAYA VERI YAZILMAYA BASLANIRSA yasal metinler ayni anda
  /// guncellenmek ZORUNDA -- tests/yasal-metin-tutarliligi.test.ts
  /// dort metni birden tariyor.
  cardBrand         String?
  cardLast4         String?
  /// Odeme kurulusunun kart referansi. Kullanilirsa DUZ METIN
  /// SAKLANMAZ -- `src/lib/crypto.ts` encryptSecret/decryptSecret.
  providerCardToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([status, currentPeriodEnd])
}

model Payment {
  id             String        @id @default(uuid())
  subscriptionId String
  /// 🔴 BIZIM urettigimiz siparis numarasi; callback bununla eslesiyor.
  /// Yalniz harf+rakam (PayTR sarti). AuditLog.actorId zorunlu oldugu
  /// ve callback'in oturum sahibi olmadigi icin actor bu satirdan
  /// cozuluyor -- imzali state'e gerek birakmiyor.
  merchantOid    String        @unique
  amount         Decimal       @db.Decimal(18, 2)
  currency       String        @default("TRY")
  status         PaymentStatus @default(PENDING)
  provider       String        @default("paytr")
  failReason     String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@index([status])
}
