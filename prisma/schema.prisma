  updatedAt       DateTime             @updatedAt
  provider        String?
  knowledgeObject KnowledgeObject      @relation(fields: [koId], references: [id], onDelete: Cascade)
  productionJobs  VideoProductionJob[]
  userProgress    VideoProgress[]

  @@index([status])
}

model VideoProgress {
  id                  String        @id @default(uuid())
  userId              Int
  videoId             String
  progressPercent     Int           @default(0)
  completed           Boolean       @default(false)
  lastWatchedAt       DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  watchedSeconds      Int           @default(0)
  furthestSecond      Int           @default(0)
  lastPositionSeconds Int           @default(0)
  video               LearningVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId])
}

model VideoProductionJob {
  id              String        @id @default(uuid())
  videoId         String
  jobType         String        @default("render")
  status          String        @default("pending")
  progressPercent Int           @default(0)
  outputKey       String?
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  provider        String?
  externalJobId   String?
  outputUrl       String?
  video           LearningVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([videoId])
}

model Flashcard {
  id              String            @id @default(uuid())
  koId            Int
  front           String
  back            String
  hint            String?
  order           Int
  status          String            @default("draft")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  knowledgeObject KnowledgeObject   @relation(fields: [koId], references: [id], onDelete: Cascade)
  reviews         FlashcardReview[]

  @@unique([koId, order])
  @@index([koId, status])
}

model FlashcardReview {
  id           String    @id @default(uuid())
  userId       Int
  flashcardId  String
  rating       String
  intervalDays Int
  easeFactor   Float
  repetition   Int
  dueAt        DateTime
  reviewedAt   DateTime
  flashcard    Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
}

model FlashcardProgress {
  id              String          @id @default(uuid())
  userId          Int
  koId            Int
  seenCount       Int             @default(0)
  masteredCount   Int             @default(0)
  percent         Int             @default(0)
  lastReviewedAt  DateTime?
  knowledgeObject KnowledgeObject @relation(fields: [koId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, koId])
  @@index([userId])
}

model AiReviewerTelemetry {
  id                  String                @id @default(uuid())
  status              String
  decision            String?
  failureCode         String?
  riskLevel           String
  issueCodes          String                @default("[]")
  requiresHumanReview Boolean               @default(false)
  groundednessScore   Float?
  pedagogicalScore    Float?
  confidence          Float?
  latencyMs           Int?
  model               String?
  createdAt           DateTime              @default(now())
  humanAudit          AiReviewerHumanAudit?

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([decision, createdAt])
  @@index([failureCode, createdAt])
}

model AiReviewerHumanAudit {
  id           String              @id @default(uuid())
  telemetryId  String              @unique
  reviewerId   Int
  verdict      String
  criticalMiss Boolean             @default(false)
  notes        String?
  createdAt    DateTime            @default(now())
  telemetry    AiReviewerTelemetry @relation(fields: [telemetryId], references: [id], onDelete: Cascade)

  @@index([verdict, createdAt])
  @@index([criticalMiss, createdAt])
  @@index([reviewerId, createdAt])
}

// --- Phase 8: Decision Check Models ---

model DecisionCheck {
  id             String                 @id @default(uuid())
  code           String                 @unique
  title          String
  description    String
  category       String?
  targetRoles    String                 @default("[]")
  published      Boolean                @default(false)
  currentVersion String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?
  sessions       DecisionCheckSession[]

  @@index([published, deletedAt])
}

model DecisionCheckVersion {
  id              String    @id @default(uuid())
  decisionCheckId String
  version         String
  status          String    @default("draft")
  definitionJson  Json
  ruleVersion     String
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([decisionCheckId, status])
}

model DecisionCheckSession {
  id              String    @id @default(uuid())
  userId          Int
  decisionCheckId String
  versionId       String?
  status          String    @default("in_progress")
  startedAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?
  archivedAt      DateTime?

  decisionCheck DecisionCheck         @relation(fields: [decisionCheckId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers       DecisionCheckAnswer[]
  result        DecisionCheckResult?

  @@index([userId, status])
  @@index([decisionCheckId])
}

model DecisionCheckAnswer {
  id           String   @id @default(uuid())
  sessionId    String
  questionCode String
  valueJson    Json
  isUnknown    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  session DecisionCheckSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionCode])
}

model DecisionCheckResult {
  id           String   @id @default(uuid())
  sessionId    String   @unique
  status       String   @default("not_ready")
  riskLevel    String   @default("undetermined")
  snapshotJson Json
  ruleVersion  String
  createdAt    DateTime @default(now())

  session DecisionCheckSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ==========================================
// PHASE 8.0C - PRACTICAL CARDS
// ==========================================

model PracticalCard {
  id               String   @id @default(uuid())
  code             String   @unique
  title            String
  type             String
  shortDescription String?
  category         String?
  published        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  versions         PracticalCardVersion[]
  knowledgeObjects PracticalCardKnowledgeObject[]
  saves            PracticalCardSave[]
  feedbacks        PracticalCardFeedback[]
}

model PracticalCardVersion {
  id              String   @id @default(uuid())
  practicalCardId String
  version         Int
  status          String   @default("draft")
  contentJson     Json
  createdAt       DateTime @default(now())

  practicalCard PracticalCard @relation(fields: [practicalCardId], references: [id], onDelete: Cascade)

  @@unique([practicalCardId, version])
}

model PracticalCardKnowledgeObject {
  practicalCardId   String
  knowledgeObjectId Int
  order             Int    @default(0)

  practicalCard   PracticalCard   @relation(fields: [practicalCardId], references: [id], onDelete: Cascade)
  knowledgeObject KnowledgeObject @relation(fields: [knowledgeObjectId], references: [id], onDelete: Cascade)

  @@id([practicalCardId, knowledgeObjectId])
}

model PracticalCardSave {
  id              String   @id @default(uuid())
  userId          Int
  practicalCardId String
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  practicalCard PracticalCard @relation(fields: [practicalCardId], references: [id], onDelete: Cascade)

  @@unique([userId, practicalCardId])
}

model PracticalCardFeedback {
  id              String   @id @default(uuid())
  userId          Int
  practicalCardId String
  value           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  practicalCard PracticalCard @relation(fields: [practicalCardId], references: [id], onDelete: Cascade)

  @@unique([userId, practicalCardId])
}

model FeedInteraction {
  id               String    @id @default(uuid())
  userId           Int
  itemKey          String
  itemType         String
  sourceEntityType String
  sourceEntityId   String
  sourceEntityCode String?
  viewedAt         DateTime?
  dismissedAt      DateTime?
  actedAt          DateTime?
  actionCode       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemKey])
  @@index([userId, dismissedAt])
  @@index([userId, viewedAt])
}

// ==========================================
// NEWS AUTOMATION
// ==========================================

enum NewsSourceType {
  RSS
  OFFICIAL_PAGE
  OFFICIAL_API
}

enum NewsCategory {
  FINANS
  MEVZUAT
  VERGI
  IS_DUNYASI
  DIJITALLESME
  DESTEK
  GENEL_EKONOMI
}

enum NewsStatus {
  PROCESSING
  PUBLISHED
  FAILED
  ARCHIVED
}

enum NewsImportance {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model NewsSource {
  id             String         @id
  name           String
  baseUrl        String
  feedUrl        String?
  type           NewsSourceType
  category       NewsCategory
  isActive       Boolean        @default(true)
  isOfficial     Boolean        @default(true)
  allowedDomains String[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  articles       NewsArticle[]

  @@index([isActive, type])
}

model NewsArticle {
  id                String          @id @default(uuid())
  sourceId          String
  category          NewsCategory
  status            NewsStatus      @default(PROCESSING)
  importance        NewsImportance?
  title             String
  canonicalUrl      String          @unique
  contentHash       String          @unique
  sourcePublishedAt DateTime
  sourceTextExcerpt String?
  summary           String?
  whyItMatters      String?
  tags              String[]
  affectedAudience  String[]
  imageId           String?
  aiProvider        String?
  aiModel           String?
  failureReason     String?
  publishedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  source            NewsSource      @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([status, sourcePublishedAt(sort: Desc), id])
  @@index([category, status, sourcePublishedAt(sort: Desc), id])
  @@index([sourceId, sourcePublishedAt(sort: Desc)])
}

// ==========================================
// PHASE 8.0D-2 - LEARNING PROGRESS
// ==========================================

model LearningProgress {
  id               String    @id @default(uuid())
  userId           Int
  contentType      String
  contentId        String
  contentCode      String?
  status           String
  progressPercent  Int?
  lastPositionJson Json?
  continueLater    Boolean   @default(false)
  startedAt        DateTime  @default(now())
  lastViewedAt     DateTime  @default(now())
  completedAt      DateTime?
  source           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentType, contentId])
  @@index([userId, status])
  @@index([userId, contentType])
  @@index([userId, lastViewedAt])
}

/// Oturum yenileme tokeni.
///
/// tokenVersion BURADA da tutuluyor: yenileme sirasinda kullanicinin
/// guncel surumuyle karsilastiriliyor. Boylece sifre degisimi,
/// "tum cihazlardan cik", sifre sifirlama, askiya alma ve
/// anonimlestirme -- yani tokenVersion i artiran HER yol -- acik
/// yenileme tokenlarini kendiliginden gecersiz kiliyor. Bes ayri
/// cagri yerine "yenileme tokenini de iptal et" eklenseydi, ileride
/// eklenecek altincisinin unutulmasi sessiz bir guvenlik acigi olurdu.
///
/// familyId: donus (rotation) ailesi. Kullanilmis bir token TEKRAR
/// sunulursa (usedAt dolu) bu, tokenin calindiginin isaretidir; o
/// zaman ailenin tamami iptal edilir.
model RefreshToken {
  id           String    @id @default(uuid())
  userId       Int
  tokenHash    String    @unique
  familyId     String
  tokenVersion Int
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}
