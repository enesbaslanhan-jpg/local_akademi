model FormulaCalculation {
  id          String   @id @default(uuid())
  userId      Int
  formulaId   String
  formulaName String
  inputs      String
  result      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ActivityEvent {
  id        String   @id @default(uuid())
  userId    Int
  eventType String
  title     String
  detail    String   @default("{}")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model GeneratedReport {
  id         String   @id @default(uuid())
  userId     Int
  reportType String
  title      String
  format     String
  storedName String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DocumentConversation {
  id         String           @id @default(uuid())
  userId     Int
  documentId String
  question   String
  answer     String
  evidence   String           @default("[]")
  aiMode     String           @default("local_extractive")
  createdAt  DateTime         @default(now())
  document   UploadedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  id                  Int                @id @default(autoincrement())
  userId              Int                @unique
  onboardingCompleted Boolean            @default(false)
  /// Karsilama turu. Ankete (onboardingCompleted) BAGLI DEGIL - ayri bayrak.
  tourCompletedAt     DateTime?
  defaultCurrency     String             @default("TRY")
  compactMode         Boolean            @default(false)
  activityLimit       Int                @default(50)
  activeWorkspaceId   String?
  /// UI language is user-scoped and deliberately independent from
  /// BusinessSetting.locale, which controls number/date formatting.
  uiLanguage          String             @default("tr")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeWorkspace     BusinessWorkspace? @relation("ActiveWorkspace", fields: [activeWorkspaceId], references: [id])
}

model BusinessWorkspace {
  id        String  @id @default(uuid())
  name      String
  legalName String?
  // VKN (10 hane) ya da TCKN (11 hane).
  //
  // NEDEN VAR: e-Fatura XML'i okunduğunda faturanın YÖNÜ ancak bununla
  // belirlenebiliyor -- faturadaki alıcı bu numaraysa gelen fatura
  // (borç), satıcı bu numaraysa giden fatura (alacak). Numara yoksa
  // yön TAHMİN EDİLMİYOR, kullanıcıya soruluyor.
  taxNumber String?

  // Gelen e-posta kutusunun YEREL parçası: fatura-<rastgele>@inbox...
  //
  // TAHMİN EDİLEMEZ olmalı. İşletme adından ya da slugtan türetilseydi
  // adresi bilen herkes belge gönderebilirdi; rastgele değer bunu bir
  // tahmin işi olmaktan çıkarıyor. Tek başına yeterli DEĞİL --
  // gönderen ayrıca doğrulanmış bir üye olmalı ve DKIM/SPF geçmeli.
  //
  // NULL ise o çalışma alanının gelen kutusu KAPALI.
  inboxKey               String?                  @unique
  slug                   String?
  sector                 String                   @default("")
  city                   String                   @default("")
  country                String                   @default("TR")
  currency               String                   @default("TRY")
  businessStage          String?
  employeeCount          Int?
  salesChannels          String                   @default("[]")
  primaryGoal            String?
  challenges             String                   @default("[]")
  monthlySales           Float                    @default(0)
  monthlyExpenses        Float                    @default(0)
  cashBalance            Float                    @default(0)
  debtBalance            Float                    @default(0)
  status                 String                   @default("active")
  createdById            Int
  archivedAt             DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  createdBy              User                     @relation(fields: [createdById], references: [id])
  members                BusinessMember[]
  invitations            BusinessInvitation[]
  contacts               BusinessContact[]
  settings               BusinessSetting?
  activities             WorkspaceActivity[]
  userPreferences        UserPreference[]         @relation("ActiveWorkspace")
  documents              UploadedDocument[]
  records                BusinessRecord[]
  recordHistory          BusinessRecordHistory[]
  reminders              BusinessReminder[]
  notifications          BusinessNotification[]
  recordDocuments        BusinessRecordDocument[]
  suggestions            DocumentSuggestion[]
  financialModelRuns     FinancialModelRun[]
  decisionJournalEntries DecisionJournalEntry[]
  inboxSenders           BusinessInboxSender[]
  integrations           IntegrationConnection[]
  marketplaceOrders      MarketplaceOrder[]
  marketplaceProducts    MarketplaceProduct[]

  @@unique([slug])
}

// Gelen kutusuna posta gonderebilen GUVENILIR adresler.
//
// Neden var: kullanici kendi posta kutusundan fatura yonlendirdiginde
// `From` basligi GONDERENDE kalir (ornegin tedarikci), kullaniciya
// donusmez. "Yalniz dogrulanmis uye gonderebilir" kurali bu yuzden
// yonlendirilen her postayi reddediyordu -- yani otomatik akis hic
// calismiyordu.
//
// Liste VARSAYILAN BOS: kullanici adres eklemedikce eski davranis
// birebir korunur. Liste kimin yazabilecegini soyler; postanin
// gercekten o adresten geldigini DKIM dogrular. Ikisi birlikte aranir.
model BusinessInboxSender {
  id          String            @id @default(uuid())
  workspaceId String
  // Kucuk harfe normalize edilmis olarak saklanir; eslesme de oyle
  // yapilir. E-posta adresleri buyuk/kucuk harfe duyarsizdir.
  email       String
  // Kullanicinin kendi verdigi ad ("Trendyol faturalari") -- listeyi
  // aylar sonra okuyabilmesi icin.
  label       String?
  addedById   Int
  createdAt   DateTime          @default(now())
  workspace   BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  addedBy     User              @relation(fields: [addedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

model BusinessMember {
  id          String            @id @default(uuid())
  workspaceId String
  userId      Int
  role        String            @default("staff")
  status      String            @default("active")
  joinedAt    DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model BusinessInvitation {
  id          String            @id @default(uuid())
  workspaceId String
  email       String
  role        String            @default("staff")
  tokenHash   String
  invitedById Int
  status      String            @default("pending")
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime          @default(now())
  workspace   BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User              @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([workspaceId])
  @@index([tokenHash])
}

model BusinessContact {
  id            String             @id @default(uuid())
  workspaceId   String
  type          String             @default("customer")
  name          String
  legalName     String?
  contactPerson String?
  email         String?
  phone         String?
  city          String?
  address       String?
  notes         String?
  status        String             @default("active")
  createdById   Int
  archivedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  workspace     BusinessWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User               @relation(fields: [createdById], references: [id])
  documents     UploadedDocument[]
  records       BusinessRecord[]

  @@index([workspaceId])
}

model BusinessSetting {
  id                String            @id @default(uuid())
  workspaceId       String            @unique
  timezone          String            @default("Europe/Istanbul")
  locale            String            @default("tr-TR")
  defaultCurrency   String            @default("TRY")
  weekStartsOn      Int               @default(1)
  notificationPrefs String            @default("{}")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  workspace         BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceActivity {
  id          String            @id @default(uuid())
  workspaceId String
  actorId     Int?
  action      String
  entityType  String
  entityId    String?
  metadata    String            @default("{}")
  createdAt   DateTime          @default(now())
  workspace   BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, entityType])
}

model Course {
  id               Int                    @id @default(autoincrement())
  title            String
  description      String
  category         String
  level            String                 @default("beginner")
  slug             String?                @unique
  estimatedMinutes Int                    @default(0)
  outcomes         String                 @default("[]")
  sourceType       String                 @default("legacy")
  sortOrder        Int                    @default(0)
  metadata         String                 @default("{}")
  published        Boolean                @default(false)
  /// Arşiv sınırı Course seviyesidir. Lesson'da arşiv alanı YOKTUR;
  /// dersler parent Course üzerinden görünürlük dışına çıkar.
  /// Geçerli durumlar:
  ///   ACTIVE   published = true  · archivedAt = null
  ///   DRAFT    published = false · archivedAt = null
  ///   ARCHIVED published = false · archivedAt != null
  /// published = true + archivedAt != null GEÇERSİZDİR.
  archivedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  enrollments      Enrollment[]
  lessons          Lesson[]
  financialCases   FinancialCase[]
  financialModels  FinancialModelCourse[]

  @@index([published, archivedAt, sortOrder])
  @@index([archivedAt])
}

model Lesson {
  id                Int              @id @default(autoincrement())
  courseId          Int
  title             String
  content           String
  order             Int
  knowledgeObjectId Int?
  estimatedMinutes  Int              @default(10)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  knowledgeObject   KnowledgeObject? @relation(fields: [knowledgeObjectId], references: [id])
  course            Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress          LessonProgress[]

  @@index([knowledgeObjectId])
}

model LessonProgress {
  id               Int       @id @default(autoincrement())
  userId           Int
  lessonId         Int
  status           String    @default("not_started")
  readingPercent   Int       @default(0)
  quizPercent      Int       @default(0)
  taskPercent      Int       @default(0)
  overallPercent   Int       @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  lastViewedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  flashcardPercent Int       @default(0)
  videoPercent     Int       @default(0)
  lesson           Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, status])
}

model Enrollment {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  progress  Int      @default(0)
  status    String   @default("not_started")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model KnowledgeObject {
  id                           Int                             @id @default(autoincrement())
  code                         String?                         @unique
  slug                         String?                         @unique
  type                         String
  title                        String
  content                      String
  embedding                    String
  metadata                     String
  status                       String                          @default("draft")
  verificationStatus           String                          @default("unverified")
  reviewGate                   String                          @default("standard")
  isDemo                       Boolean                         @default(false)
  publishedAt                  DateTime?
  archivedAt                   DateTime?
  reviewDue                    DateTime?
  categoryId                   Int?
  currentVersionId             Int?
  createdAt                    DateTime                        @default(now())
  updatedAt                    DateTime                        @updatedAt
  applySteps                   String?
  learnSteps                   String?
  problem                      String?
  quickAnswer                  String?
  seeAlso                      String?
  summary                      String?
  task                         String?
  warning                      String?
  flashcards                   Flashcard[]
  flashcardProgress            FlashcardProgress[]
  currentVersion               KnowledgeObjectVersion?         @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  category                     Category?                       @relation(fields: [categoryId], references: [id])
  sources                      KnowledgeObjectSource[]
  versions                     KnowledgeObjectVersion[]        @relation("VersionHistory")
  knowledgeProgress            KnowledgeProgress[]
  videos                       LearningVideo?
  courseLessons                Lesson[]
  publicationEvents            PublicationEvent[]
  quizzes                      Quiz[]
  reviews                      ReviewRecord[]
  taskTemplates                TaskTemplate[]
  financialModels              FinancialModelKnowledgeObject[]
  PracticalCardKnowledgeObject PracticalCardKnowledgeObject[]
}

model Category {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  slug             String?           @unique
  description      String?
  isActive         Boolean           @default(true)
  parentId         Int?
  createdAt        DateTime          @default(now())
  parent           Category?         @relation("SubCategories", fields: [parentId], references: [id])
  children         Category[]        @relation("SubCategories")
  knowledgeObjects KnowledgeObject[]
}

model KnowledgeObjectVersion {
  id              Int               @id @default(autoincrement())
  koId            Int
  versionNumber   Int
  changes         String
  createdBy       Int
  createdAt       DateTime          @default(now())
  currentFor      KnowledgeObject[] @relation("CurrentVersion")
  creator         User              @relation(fields: [createdBy], references: [id])
  knowledgeObject KnowledgeObject   @relation("VersionHistory", fields: [koId], references: [id], onDelete: Cascade)
}

model Source {
  id             String                  @id @default(uuid())
  title          String
  url            String?
  authorityLevel String                  @default("medium")
  lastChecked    DateTime?
  createdAt      DateTime                @default(now())
  koSources      KnowledgeObjectSource[]
}

model KnowledgeObjectSource {
  id              String          @id @default(uuid())
  koId            Int
  sourceId        String
  relation        String          @default("references")
  note            String?
  createdAt       DateTime        @default(now())
  source          Source          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  knowledgeObject KnowledgeObject @relation(fields: [koId], references: [id], onDelete: Cascade)
}

model ReviewRecord {
  id              String          @id @default(uuid())
  koId            Int
  reviewerId      Int
  status          String          @default("pending")
  notes           String?
  reviewedAt      DateTime?
  createdAt       DateTime        @default(now())
  reviewer        User            @relation(fields: [reviewerId], references: [id])
  knowledgeObject KnowledgeObject @relation(fields: [koId], references: [id], onDelete: Cascade)
}

model Quiz {
  id              String          @id @default(uuid())
  koId            Int
  title           String
  passScore       Int             @default(70)
  createdAt       DateTime        @default(now())
  status          String          @default("published")
  knowledgeObject KnowledgeObject @relation(fields: [koId], references: [id], onDelete: Cascade)
  questions       QuizQuestion[]

  @@index([koId, status])
}

model QuizQuestion {
  id            String   @id @default(uuid())
  quizId        String
  questionText  String
  options       String
  correctAnswer String
  explanation   String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model TaskTemplate {
  id              String                       @id @default(uuid())
  koId            Int
  title           String
  description     String
  estimatedTime   Int                          @default(10)
  createdAt       DateTime                     @default(now())
  instructions    String?
  exampleOutput   String?
  checklist       String?
  rubric          String?
  assignments     TaskAssignment[]
  knowledgeObject KnowledgeObject              @relation(fields: [koId], references: [id], onDelete: Cascade)
  financialModels FinancialModelTaskTemplate[]
}

model FinancialModel {
  id                  String                          @id @default(uuid())
  code                String                          @unique
  name                String
  category            String
  purpose             String
  description         String
  engineType          String                          @default("deterministic")
  engineVersion       String
  policyVersion       String
  status              String                          @default("active")
  inputSchema         Json
  outputSchema        Json
  formulaDefinition   Json
  interpretationRules Json
  warningRules        Json
  limitations         Json
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  versions            FinancialModelVersion[]
  runs                FinancialModelRun[]
  cases               FinancialCaseModel[]
  courses             FinancialModelCourse[]
  knowledgeObjects    FinancialModelKnowledgeObject[]
  taskTemplates       FinancialModelTaskTemplate[]

  @@index([category, status])
}

model FinancialModelVersion {
  id                  String              @id @default(uuid())
  financialModelId    String
  version             String
  formulaDefinition   Json
  inputSchema         Json
  outputSchema        Json
  interpretationRules Json
  warningRules        Json
  changeSummary       String
  createdAt           DateTime            @default(now())
  financialModel      FinancialModel      @relation(fields: [financialModelId], references: [id], onDelete: Cascade)
  runs                FinancialModelRun[]

  @@unique([financialModelId, version])
  @@index([financialModelId, createdAt])
}

model FinancialModelRun {
  id               String                 @id @default(uuid())
  modelId          String
  modelVersionId   String
  userId           Int
  businessId       String
  sourceDocumentId String?
  caseId           String?
  scenarioName     String                 @default("base")
  inputs           Json
  normalizedInputs Json
  assumptions      Json
  outputs          Json
  checks           Json
  warnings         Json
  confidence       Json
  calculationTrace Json
  status           String                 @default("completed")
  createdAt        DateTime               @default(now())
  model            FinancialModel         @relation(fields: [modelId], references: [id])
  modelVersion     FinancialModelVersion  @relation(fields: [modelVersionId], references: [id])
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  business         BusinessWorkspace      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sourceDocument   UploadedDocument?      @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  case             FinancialCase?         @relation(fields: [caseId], references: [id], onDelete: SetNull)
  modelAssumptions ModelAssumption[]
  decisions        DecisionJournalEntry[]

  @@index([businessId, createdAt])
  @@index([userId, createdAt])
  @@index([modelId, businessId])
  @@index([sourceDocumentId])
  @@index([caseId])
}

model ModelAssumption {
  id              String            @id @default(uuid())
  runId           String
  key             String
  value           Json
  unit            String?
  sourceType      String
  sourceReference String?
  effectiveDate   DateTime?
  confidence      Float             @default(0.5)
  userVerified    Boolean           @default(false)
  createdAt       DateTime          @default(now())
  run             FinancialModelRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model FinancialCase {
  id               String               @id @default(uuid())
  code             String               @unique
  title            String
  courseId         Int?
  difficulty       String
  companyProfile   Json
  problemStatement String
  dataset          Json
  evidence         Json
  ethicalIssue     String?
  expectedModels   Json
  decisionContext  String
  outcome          Json?
  status           String               @default("draft")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  course           Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  models           FinancialCaseModel[]
  runs             FinancialModelRun[]

  @@index([courseId, status])
}

model DecisionJournalEntry {
  id              String            @id @default(uuid())
  userId          Int
  businessId      String
  modelRunId      String
  decision        String
  expectedOutcome String
  actualOutcome   String?
  variance        String?
  lessonLearned   String?
  createdAt       DateTime          @default(now())
  reviewedAt      DateTime?
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  business        BusinessWorkspace @relation(fields: [businessId], references: [id], onDelete: Cascade)
  modelRun        FinancialModelRun @relation(fields: [modelRunId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([userId, reviewedAt])
  @@index([modelRunId])
}

model FinancialCaseModel {
  caseId  String
  modelId String
  case    FinancialCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  model   FinancialModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@id([caseId, modelId])
}

model FinancialModelCourse {
  modelId  String
  courseId Int
  model    FinancialModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([modelId, courseId])
}

model FinancialModelKnowledgeObject {
  modelId         String
  koId            Int
  model           FinancialModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  knowledgeObject KnowledgeObject @relation(fields: [koId], references: [id], onDelete: Cascade)

  @@id([modelId, koId])
}

model FinancialModelTaskTemplate {
  modelId        String
