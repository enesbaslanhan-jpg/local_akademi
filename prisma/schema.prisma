generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        Int                      @id @default(autoincrement())
  email                     String                   @unique
  password                  String
  name                      String
  role                      String                   @default("student")
  /// Oturum iptali: token icindeki surum bununla eslesmezse istek reddedilir.
  /// Sifre degisiminde ve "tum cihazlardan cik" isleminde artirilir.
  tokenVersion              Int                      @default(0)
  /// E-posta dogrulandiysa zamani. Null = dogrulanmamis.
  emailVerifiedAt           DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  deletedAt                 DateTime?
  avatarStoredName          String?
  avatarMimeType            String?
  /// Profil ozellestirme (22.08.2026). Profiller uyeler arasinda
  /// ziyaret edilebilir hale geldigi icin bu alanlar DIGER UYELERE
  /// GORUNUR -- aydinlatma metninde karsiligi olmali.
  bio                       String?
  location                  String?
  websiteUrl                String?
  /// Kapak gorseli. Avatar ile ayni desen: dosya diskte, adi burada.
  coverStoredName           String?
  coverMimeType             String?
  activityEvents            ActivityEvent[]
  businessAssessments       BusinessAssessment[]
  businessProfile           BusinessProfile?
  createdWorkspaces         BusinessWorkspace[]
  workspaceMemberships      BusinessMember[]
  sentInvitations           BusinessInvitation[]     @relation("InvitedBy")
  createdContacts           BusinessContact[]
  moderatedCommunityPosts   CommunityPost[]          @relation("CommunityPostModerator")
  communityPosts            CommunityPost[]          @relation("CommunityPostAuthor")
  communityMedia            CommunityMedia[]
  communityReports          CommunityReport[]
  bildirdigiKullanicilar    CommunityUserReport[]    @relation("CommunityUserReportReporter")
  hakkindakiSikayetler      CommunityUserReport[]    @relation("CommunityUserReportReported")
  communityLikes            CommunityLike[]
  communityNotifications    CommunityNotification[]  @relation("CommunityNotificationUser")
  communityNotificationActs CommunityNotification[]  @relation("CommunityNotificationActor")
  communityBookmarks        CommunityBookmark[]
  communityFollowing        CommunityFollow[]        @relation("CommunityFollowing")
  communityFollowers        CommunityFollow[]        @relation("CommunityFollowers")
  communityBlocksMade       CommunityBlock[]         @relation("CommunityBlocker")
  communityBlocksReceived   CommunityBlock[]         @relation("CommunityBlocked")
  communityThreadMembers    CommunityThreadMember[]
  communityMessages         CommunityMessage[]
  createdCommunityThreads   CommunityThread[]        @relation("CommunityThreadCreator")
  createdCommunityAds       CommunityAd[]
  conversations             Conversation[]
  conversationSummaries     ConversationSummary[]
  documentConversations     DocumentConversation[]
  enrollments               Enrollment[]
  flashcardProgress         FlashcardProgress[]
  flashcardReviews          FlashcardReview[]
  formulaCalculations       FormulaCalculation[]
  generatedReports          GeneratedReport[]
  createdVersions           KnowledgeObjectVersion[]
  knowledgeProgress         KnowledgeProgress[]
  learningPaths             LearningPath[]
  lessonProgress            LessonProgress[]
  mentorSessions            MentorSession[]
  publicationEvents         PublicationEvent[]
  quizAttempts              QuizAttempt[]
  reviewRecords             ReviewRecord[]
  taskAssignments           TaskAssignment[]
  uploadedDocuments         UploadedDocument[]
  memories                  UserMemory[]
  userPreference            UserPreference?
  videoProgress             VideoProgress[]
  assignedBusinessRecords   BusinessRecord[]         @relation("AssignedBusinessRecords")
  createdBusinessRecords    BusinessRecord[]         @relation("CreatedBusinessRecords")
  updatedBusinessRecords    BusinessRecord[]         @relation("UpdatedBusinessRecords")
  businessReminders         BusinessReminder[]
  businessNotifications     BusinessNotification[]
  accountNotifications      AccountNotification[]
  financialModelRuns        FinancialModelRun[]
  decisionJournalEntries    DecisionJournalEntry[]
  DecisionCheckSession      DecisionCheckSession[]
  practicalCardSaves        PracticalCardSave[]
  practicalCardFeedbacks    PracticalCardFeedback[]
  feedInteractions          FeedInteraction[]
  LearningProgress          LearningProgress[]
  passwordResetTokens       PasswordResetToken[]
  emailVerificationCodes    EmailVerificationCode[]
  consents                  UserConsent[]
  refreshTokens             RefreshToken[]
  addedInboxSenders         BusinessInboxSender[]
  createdIntegrations       IntegrationConnection[]  @relation("IntegrationConnections")
  subscription              Subscription?
  billingProfile            BillingProfile?

  @@index([deletedAt])
}

/// Sifre sifirlama tokeni. BusinessInvitation ile ayni desen: ham token
/// e-postayla gider, veritabaninda yalniz sha256 ozeti durur. Veritabani
/// sizarsa tokenlar kullanilamaz.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    Int
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// E-posta dogrulama kodu (6 hane). Kod da ozetlenerek saklanir.
/// `attempts` deneme sayaci: kaba kuvvetle 6 hane denenmesini engeller.
model EmailVerificationCode {
  id        String    @id @default(uuid())
  userId    Int
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// Yasal metin onaylari. KVKK acisindan onemli olan onayi KANITLAYABILMEK:
/// kim, ne zaman, metnin hangi surumunu onayladi.
/// IP adresi BILEREK saklanmiyor - kendisi kisisel veridir; saklamak korunmasi
/// gereken veriyi artirir ve ayri bir saklama gerekcesi ister.
model UserConsent {
  id           String   @id @default(uuid())
  userId       Int
  documentType String
  version      String
  acceptedAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentType, version])
  @@index([userId])
}

model CommunityPost {
  id                String    @id @default(uuid())
  authorId          Int?
  moderatedById     Int?
  postType          String
  title             String?
  summary           String
  content           String?
  category          String?
  sourceUrl         String?
  sourceTitle       String?
  sourcePublishedAt DateTime?
  status            String    @default("pending")
  moderationReason  String?
  publishedAt       DateTime?
  moderatedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  /// Yanit verilen gonderi. X'te bir yanit KENDISI de bir gonderidir;
  /// ayri bir Comment modeli yazmak medya, sikayet, kaldirma ve yetki
  /// mantiginin ikinci bir kopyasini gerektirirdi.
  parentId          String?
  /// Alintilanan gonderi. Alinti da bir gonderidir, sadece baska bir
  /// gonderiye isaret eder.
  quotedPostId      String?

  moderatedBy User?             @relation("CommunityPostModerator", fields: [moderatedById], references: [id])
  author      User?             @relation("CommunityPostAuthor", fields: [authorId], references: [id])
  reports     CommunityReport[]
  media       CommunityMedia?

  parent        CommunityPost?          @relation("CommunityPostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       CommunityPost[]         @relation("CommunityPostReplies")
  /// SetNull: alintilanan satir gercekten silinirse alinti AYAKTA kalir
  /// ve "kaynak bulunamiyor" gosterir. Cascade olsaydi baskasinin yazisi
  /// da giderdi.
  quotedPost    CommunityPost?          @relation("CommunityPostQuotes", fields: [quotedPostId], references: [id], onDelete: SetNull)
  quotes        CommunityPost[]         @relation("CommunityPostQuotes")
  likes         CommunityLike[]
  bookmarks     CommunityBookmark[]
  notifications CommunityNotification[]

  @@index([status, publishedAt])
  @@index([postType, status])
  @@index([authorId, createdAt])
  /// Yanit agacini tek sorguda cekmek icin.
  @@index([parentId, createdAt])
  @@index([quotedPostId])
}

model CommunityMedia {
  id           String         @id @default(uuid())
  uploaderId   Int
  postId       String?        @unique
  originalName String
  storedName   String         @unique
  mimeType     String
  sizeBytes    Int
  kind         String
  createdAt    DateTime       @default(now())
  uploader     User           @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  post         CommunityPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([uploaderId, createdAt])
}

model CommunityReport {
  id           String        @id @default(uuid())
  postId       String
  reporterId   Int
  reason       String
  details      String?
  status       String        @default("open")
  resolution   String?
  resolvedById Int?
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())
  reporter     User          @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  post         CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, reporterId])
  @@index([status, createdAt])
  @@index([postId, status])
}

model CommunityFollow {
  id          String   @id @default(uuid())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())
  follower    User     @relation("CommunityFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("CommunityFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
}

model CommunityBlock {
  id        String   @id @default(uuid())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())
  blocker   User     @relation("CommunityBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("CommunityBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model CommunityThread {
  id            String                  @id @default(uuid())
  name          String?
  isGroup       Boolean                 @default(false)
  createdById   Int
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  createdBy     User                    @relation("CommunityThreadCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members       CommunityThreadMember[]
  messages      CommunityMessage[]
  notifications CommunityNotification[]
}

/// Grup daveti kabul ister (urun karari, 22.08.2026): kimse haberi
/// olmadan bir gruba atilamaz. `status` bunun icin.
model CommunityThreadMember {
  threadId String
  userId   Int
  role     String          @default("member")
  /// `invited` | `joined`. Davet kabul edilene kadar kisi mesajlari
  /// GORMEZ ve yazamaz -- uyelik satirinin varligi tek basina yetmez.
  status   String          @default("joined")
  joinedAt DateTime        @default(now())
  thread   CommunityThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
  @@index([userId, joinedAt])
}

model CommunityMessage {
  id        String          @id @default(uuid())
  threadId  String
  senderId  Int
  body      String
  createdAt DateTime        @default(now())
  thread    CommunityThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    User            @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

/// Reklam. Sayaclar TOPLAM tutulur; KIMIN gordugu KAYDEDILMEZ
/// (urun karari, 22.08.2026). Kisi bazinda olcum gercek izlemedir ve
/// StorageNotice'taki "hicbir ucuncu taraf izleme araci calistirmiyor"
/// taahhudunu ve cerez politikasini degistirmeyi gerektirirdi.
/// TOPLULUK BILDIRIMI.
///
/// `BusinessNotification` KULLANILAMADI: o calisma alanina bagli
/// (`workspaceId` zorunlu) ve topluluk olaylarinin calisma alani yok.
///
/// Bu olmadan sosyal katman GORUNMEZ: kimse takip edildigini, mesaj
/// geldigini ya da gonderisine yanit yazildigini ogrenmiyor.
model CommunityNotification {
  id        String    @id @default(uuid())
  /// Bildirimi ALAN kisi.
  userId    Int
  /// Olayi YAPAN kisi. Silinirse bildirim de gitmeli.
  actorId   Int?
  /// `follow` | `message` | `reply` | `like` | `quote` | `thread_invite`
  type      String
  /// Ilgili gonderi ya da sohbet; turune gore doldurulur.
  postId    String?
  threadId  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user   User             @relation("CommunityNotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actor  User?            @relation("CommunityNotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post   CommunityPost?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  thread CommunityThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

/// HESAP BILDIRIMI (uyelik, odeme, guvenlik).
///
/// UCUNCU bildirim tablosu. Sebebi olculdu, tercih degil:
///
///   * BusinessNotification: workspaceId ZORUNLU. Isletmesi olmayan
///     kullanici uyelik uyarisi hic alamazdi; iki isletmesi olan ayni
///     uyariyi iki kez alirdi. Uyelik ise kullanici bazlidir.
///   * CommunityNotification: kullanici bazli ama turleri sosyal
///     (follow / like / reply ...) ve dedupeKey YOK. Uretici belirli
///     araliklarla calistigi icin ayni "5 gun kaldi" uyarisi her
///     turda yeniden duserdi.
///
/// dedupeKey bu yuzden zorunlu degil ama @unique: uretici ayni olayi
/// ikinci kez yazmaya calistiginda veritabani durduruyor.
model AccountNotification {
  id        String    @id @default(uuid())
  userId    Int
  /// trial_ending | trial_ended | payment_succeeded | payment_failed |
  /// renewal_upcoming | membership_cancelled
  type      String
  title     String
  body      String
  /// Tiklaninca gidilecek uygulama ici yol (or. /app/settings#uyelik).
  linkTo    String?
  /// Ayni olayin tekrar yazilmasini engelleyen anahtar.
  dedupeKey String?   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model CommunityAd {
  id          String   @id @default(uuid())
  title       String
  body        String
  ctaLabel    String?
  ctaUrl      String?
  active      Boolean  @default(true)
  /// Medya: topluluk medya hattindan geliyor (imzali adres, sihirli
  /// bayt dogrulamasi). Ikinci bir yukleme yolu yazilmadi.
  mediaId     String?
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([active, createdAt])
}

/// Begeni. Desen uydurulmadi: PracticalCardSave ile ayni sekil.
/// Sayilar burada TUTULMUYOR; Prisma `_count` ile okunuyor. Erken
/// denormalizasyon tutarsizlik kaynagidir -- akis yavaslarsa sayac
/// sutunu o zaman eklenir.
model CommunityLike {
  id        String        @id @default(uuid())
  userId    Int
  postId    String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  /// Iki kez begenmek tek kayit uretir; sayimin dogrulugu buna bagli.
  @@unique([userId, postId])
  @@index([postId])
}

/// Kaydetme ("kaydettiklerim"). Begeniden AYRI: begeni herkese acik bir
/// onay, kaydetme kisiye ozel bir yer imi. Ayni tabloda `tur` sutunuyla
/// birlestirmek, ileride biri herkese acik digeri gizli kaldiginda
/// yetki mantigini tek satirda cakistirirdi.
model CommunityBookmark {
  id        String        @id @default(uuid())
  userId    Int
  postId    String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
}

/// KULLANICI SIKAYETI.
///
/// `CommunityReport` GONDERIYE bagli. Profil ve ozel mesaj gelince
/// yetmez oldu: taciz tek bir gonderide olmayabilir -- birden cok
/// mesajda, profil metninde ya da davranis oruntusunde olabilir.
///
/// Ayni modele "ya postId ya userId" diye iki opsiyonel alan koymak
/// her sorguyu "hangisi dolu" kontroluyle kirletirdi.
model CommunityUserReport {
  id           String    @id @default(uuid())
  /// Sikayet EDEN.
  reporterId   Int
  /// Sikayet EDILEN.
  reportedId   Int
  reason       String
  details      String?
  status       String    @default("open")
  resolution   String?
  resolvedById Int?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  reporter User @relation("CommunityUserReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("CommunityUserReportReported", fields: [reportedId], references: [id], onDelete: Cascade)

  /// Ayni kisiyi bir kez sikayet edilebilir: tekrar tekrar bildirmek
  /// kuyrugu doldurur ve gercek sikayetleri gorunmez yapar.
  @@unique([reporterId, reportedId])
  @@index([status, createdAt])
  @@index([reportedId, status])
}

model QuizAttempt {
  id        String   @id @default(uuid())
  userId    Int
  koId      Int
  score     Int
  passed    Boolean
  feedback  String
  createdAt DateTime @default(now())
  quizId    String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, koId])
}

model TaskAssignment {
  id              String        @id @default(uuid())
  userId          Int
  taskId          String
  koId            Int
  taskTemplateId  String?
  status          String        @default("assigned")
  progressPercent Int           @default(0)
  answers         String        @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  reviewStatus    String?       @default("pending")
  feedback        String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  taskTemplate    TaskTemplate? @relation(fields: [taskTemplateId], references: [id])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskTemplateId])
  @@index([reviewStatus])
}

model UploadedDocument {
  id                 String                   @id @default(uuid())
  userId             Int
  originalName       String
  storedName         String
  mimeType           String
  sizeBytes          Int
  extractedText      String                   @default("")
  analysis           String                   @default("{}")
  status             String                   @default("pending")
  workspaceId        String?
  category           String?
  documentDate       DateTime?
  dueDate            DateTime?
  contactId          String?
  analysisStatus     String                   @default("pending")
  archivedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  conversations      DocumentConversation[]
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace          BusinessWorkspace?       @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  contact            BusinessContact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  recordDocuments    BusinessRecordDocument[]
  suggestions        DocumentSuggestion[]
  financialModelRuns FinancialModelRun[]

  @@index([workspaceId, archivedAt])
  @@index([workspaceId, category])
  @@index([contactId])
}

model BusinessRecord {
  id             String                   @id @default(uuid())
  workspaceId    String
  type           String
  title          String
  description    String?
  direction      String                   @default("neutral")
  amount         Decimal?                 @db.Decimal(18, 2)
  currency       String                   @default("TRY")
  status         String                   @default("open")
  priority       String                   @default("normal")
  dueAt          DateTime?
  originalDueAt  DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  contactId      String?
  assignedToId   Int?
  createdById    Int
  updatedById    Int?
  recurrenceRule String?
  parentRecordId String?                  @unique
  metadata       String                   @default("{}")
  archivedAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  workspace      BusinessWorkspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact        BusinessContact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedTo     User?                    @relation("AssignedBusinessRecords", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy      User                     @relation("CreatedBusinessRecords", fields: [createdById], references: [id])
  updatedBy      User?                    @relation("UpdatedBusinessRecords", fields: [updatedById], references: [id], onDelete: SetNull)
  parentRecord   BusinessRecord?          @relation("ChildBusinessRecords", fields: [parentRecordId], references: [id], onDelete: SetNull)
  childRecords   BusinessRecord[]         @relation("ChildBusinessRecords")
  history        BusinessRecordHistory[]
  reminders      BusinessReminder[]
  notifications  BusinessNotification[]
  documents      BusinessRecordDocument[]

  @@index([workspaceId, type])
  @@index([workspaceId, status])
  @@index([workspaceId, dueAt])
  @@index([workspaceId, assignedToId])
  @@index([workspaceId, contactId])
  @@index([workspaceId, archivedAt])
}

model BusinessRecordHistory {
  id           String            @id @default(uuid())
  workspaceId  String
  recordId     String
  actorId      Int?
  action       String
  previousData String?
  newData      String?
  reason       String?
  createdAt    DateTime          @default(now())
  workspace    BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  record       BusinessRecord    @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId, createdAt])
  @@index([workspaceId, createdAt])
}

model BusinessReminder {
  id          String            @id @default(uuid())
  workspaceId String
  recordId    String
  recipientId Int
  channel     String            @default("in_app")
  scheduledAt DateTime
  status      String            @default("pending")
  sentAt      DateTime?
  dedupeKey   String            @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  record      BusinessRecord    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  recipient   User              @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([scheduledAt, status])
}

model BusinessNotification {
  id          String            @id @default(uuid())
  workspaceId String
  userId      Int
  recordId    String?
  dedupeKey   String?           @unique
  type        String
  title       String
  body        String
  readAt      DateTime?
  createdAt   DateTime          @default(now())
  workspace   BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  record      BusinessRecord?   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, readAt])
  @@index([workspaceId, userId, createdAt])
}

model BusinessRecordDocument {
  id           String            @id @default(uuid())
  workspaceId  String
  recordId     String
  documentId   String
  attachedById Int
  createdAt    DateTime          @default(now())
  workspace    BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  record       BusinessRecord    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  document     UploadedDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([recordId, documentId])
  @@index([workspaceId])
  @@index([documentId])
}

// Onay bekleyen kayit onerisi.
//
// Iki KAYNAKTAN gelebilir ve tam olarak biri doludur:
//   documentId         -> yuklenen/e-postayla gelen belgeden (e-Fatura)
//   sourceKey          -> pazaryeri siparislerinden (gunluk ozet)
//
// Neden ayni model: onay akisi, iyimser kilit, gecmis kaydi ve
// hatirlatma esitlemesi zaten burada yazili. Siparis icin ikinci bir
// oneri modeli acmak, o mantigin tamaminin kopyasini gerektirirdi ve
// iki akis kacinilmaz olarak ayrisirdi.
model DocumentSuggestion {
  id             String            @id @default(uuid())
  workspaceId    String
  // Pazaryeri kaynakli onerilerde NULL. Belge kaynaklilarda dolu.
  documentId     String?
  // Belge kaynaklilarda NULL. Pazaryeri kaynaklilarda kaynagi TEKIL
  // olarak tanimlar; ornek: "marketplace:TRENDYOL:2026-08-24".
  //
  // 🔴 NEDEN SIPARIS BASINA DEGIL, GUNLUK OZET:
  // Marketci gunde 40 hareket yapiyor. Siparis basina oneri, gunde 40
  // onay kuyrugu demekti -- kullanicinin uygulamayi ikinci gun
  // birakmasinin sebebi tam olarak buydu. Nakit takibinde dogru soru
  // "37. siparis ne kadardi" degil, "bu gun ne kadar tahsilat dustu".
  //
  // @@unique([workspaceId, sourceKey]) tekrar korumasi: esitleme ayni
  // gunu her turda yeniden gorur; koruma olmadan kuyruk kopyalarla
  // dolardi.
  sourceKey      String?
  suggestionType String
  payload        String
  confidence     Float
  evidence       String?
  status         String            @default("proposed")
  reviewedById   Int?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  workspace      BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document       UploadedDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, sourceKey])
  @@index([workspaceId, documentId])
  @@index([status])
}

model BusinessProfile {
  id                    Int      @id @default(autoincrement())
  userId                Int      @unique
  name                  String   @default("")
  sector                String   @default("")
  city                  String   @default("")
  currency              String   @default("TRY")
  monthlySales          Float    @default(0)
  monthlyExpenses       Float    @default(0)
  cashBalance           Float    @default(0)
  debtBalance           Float    @default(0)
  businessStage         String?
  employeeCount         Int?
  salesChannels         String   @default("[]")
  primaryGoal           String?
  weeklyLearningMinutes Int?
  challenges            String   @default("[]")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusinessAssessment {
  id              String   @id @default(uuid())
  userId          Int
  version         Int      @default(1)
  answers         String
  scores          String
  priorityDomains String
  recommendations String
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model KnowledgeProgress {
  id              String          @id @default(uuid())
  userId          Int
  koId            Int
  status          String          @default("not_started")
  progressPercent Int             @default(0)
  startedAt       DateTime?
