# LocalKarar — uretim ortam degiskenleri
#
# Sunucuda `.env` olarak kopyala ve doldur. Bu dosya ORNEK; gercek
# degerleri buraya YAZMA, depoya girer.
#
#   cp deploy/env.production.example .env && nano .env

# ── Zorunlu: kimlik ────────────────────────────────────────────────
# Uret:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ── Zorunlu: veritabani ────────────────────────────────────────────
# Iki AYRI parola. `DB_PASSWORD` sahip rol (gocler icin),
# `APP_DB_PASSWORD` uygulamanin en az yetkili rolu.
DB_PASSWORD=
APP_DB_PASSWORD=

# ── Zorunlu: adresler ──────────────────────────────────────────────
APP_PUBLIC_URL=https://localkarar.com

# Iletisim formundan gelen destek mesajlari buraya duser.
# Tanimsizsa form calismaz ve kullaniciya 503 ile "su anda kullanilamiyor"
# der -- sessizce yutup "gonderildi" DEMEZ.
SUPPORT_MAIL_TO=kvkk@localkarar.com
CORS_ORIGIN=https://localkarar.com

# ── Zorunlu: e-posta ───────────────────────────────────────────────
# Resend → API keys. MAIL_FROM, Resend'de DOGRULANAN alan adiyla ayni
# olmali (mail.localkarar.com), yoksa gonderim reddedilir.
RESEND_API_KEY=
MAIL_FROM="LocalKarar <bildirim@mail.localkarar.com>"

# ── 🔴 Ters vekil ──────────────────────────────────────────────────
# Zincir: Cloudflare → Caddy → Fastify = 2 sicrama.
#
# `true` YAZMA. Olculmustu: kosulsuz guven halinde X-Forwarded-For
# uydurularak 3/saat sinirinda 6/6 istek geciyordu. Sayi vermek,
# yalniz bilinen sicrama kadarini guvenilir sayar.
TRUST_PROXY=2

# ── AI saglayici ───────────────────────────────────────────────────
# Mentor DOGRUDAN Mistral'a baglaniyor (Fransa / AB).
#
# OmniRoute KULLANILMIYOR. Sebebi: OmniRoute yerel cikarim yapmiyor,
# bir YONLENDIRICI -- kendisi de Mistral'a gidiyordu (bkz. Faz 0
# olcumu, PHASE_0_PREREQUISITES.md). Loopback'te calistigi icin
# "yerel" gorunuyordu; degildi. Ustelik sunucuda calismasi imkansiz,
# cunku kullanicinin kendi makinesinde kurulu.
#
# Asagidaki `omniroute` adi tarihsel: kod bunu genel bir
# OpenAI-uyumlu istemci olarak kullaniyor ({base}/chat/completions +
# Bearer). Mistral'in API'si tam olarak bu sekilde.
AI_PROVIDER=omniroute
OMNIROUTE_BASE_URL=https://api.mistral.ai/v1
OMNIROUTE_API_KEY=
# MODEL SABIT OLMALI. Eski deger `auto/best-free` bir HAVUZDAN secim
# yapiyordu ve havuzda ABD saglayicilari da vardi. Alici sessizce
# degisince aydinlatma metni yanlis hale gelir -- bir metin alici
# kategorilerini ve ulkeleri adlandirmak zorundadir.
# Onek YOK: OmniRoute'ta `mistral/mistral-large-latest` yaziliyordu,
# dogrudan Mistral'da `mistral/` oneki kabul edilmez.
OMNIROUTE_MODEL=mistral-large-latest

# Adres loopback olmadigi icin bu ZORUNLU. Kod bilerek reddediyor ve
# gerekcesi yerinde: veri sunucu disina cikiyor. Bilincli bir taviz --
# veri zaten cikiyordu, artik gorunur.
AI_ALLOW_EXTERNAL_PROVIDERS=true

# ── KVKK notlari (aydinlatma metnine girecek) ──────────────────────
# * Mentor sohbetleri Mistral AI (Fransa) sunucularinda islenir.
# * Kotuye kullanim denetimi icin 30 GUN saklanir. Ucretsiz katmanda
#   kapatilamaz (Zero Data Retention yalniz ucretli Scale planinda).
# * EGITIMDE KULLANIM VARSAYILAN OLARAK ACIK. console.mistral.ai ->
#   Privacy -> "Anonymous improvement data" VE API > Privacy ->
#   "Data usage for improving our services" kapatilmali. Ucretsiz.

# ── Yedekleme ──────────────────────────────────────────────────────
# Postgres kapsayicida calistigi ve pg_dump ana makinede olmayabilecegi
# icin betikler kapsayicidaki araclari kullanabiliyor.
PG_DOCKER_CONTAINER=localakademi-postgres
DATABASE_BACKUP_RETENTION_COUNT=14

# ── Ozellik bayraklari ─────────────────────────────────────────────
# Bunlari BOS BIRAKABILIRSIN: deploy/docker-compose.prod.yml icinde
# gelistirme ortamiyla ayni varsayilanlar tanimli. Burada tanimlarsan
# oradaki varsayilani ezersin.
#
# Neden onemli: kod `=== 'true'` karsilastiriyor, yani tanimsiz bayrak
# KAPALI demek. Ilk kurulumda yedisi de kapali kalmisti ve Karar
# Araclari sayfasi "Araclar yuklenemedi" veriyordu (404 FEATURE_DISABLED).
#
# FEATURE_DECISION_CHECKS_ENABLED=true
# FEATURE_LEARNING_PROGRESS_ENABLED=true
# FEATURE_PERSONALIZED_FEED_ENABLED=true
# FEATURE_CONTEXTUAL_MENTOR_ENABLED=true
# FEATURE_LEGACY_QUIZ_ENABLED=false
# FEATURE_LEGACY_FLASHCARDS_ENABLED=false
# FEATURE_PRACTICAL_CARDS_ENABLED=false

# ---------------------------------------------------------------
# GELEN E-POSTA KANALI (Faz E)
# ---------------------------------------------------------------
# Cloudflare Email Worker ile sunucu arasındaki paylaşılan anahtar.
#
# 🔴 BU DEĞİŞKEN YOKSA KANAL TAMAMEN KAPALI: `/inbound/email` ucu HİÇ
# kaydedilmiyor. Boş bir anahtarla açık bırakmak, internete kimliksiz
# bir belge yükleme kapısı açmak olurdu.
#
# En az 32 karakter. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# AYNI değer Cloudflare Worker'ında `INBOUND_SECRET` olarak, "Encrypt"
# işaretli biçimde tanımlanmalı.
INBOUND_MAIL_SECRET=
