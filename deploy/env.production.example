# LocalKarar — uretim ortam degiskenleri
#
# Sunucuda `.env` olarak kopyala ve doldur. Bu dosya ORNEK; gercek
# degerleri buraya YAZMA, depoya girer.
#
#   cp deploy/env.production.example .env && nano .env

# ── Zorunlu: kimlik ────────────────────────────────────────────────
# Uret:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ── Zorunlu: pazaryeri kimlik bilgisi sifrelemesi ──────────────────
#
# 🔴 BOS BIRAKMA. Bu dosyada uzun sure HIC YOKTU; docker-compose onu
# bos varsayilanla geciriyor, uygulama da bos gorunce anahtari
# JWT_SECRET'ten TURETIYOR.
#
# Sonucu: JWT_SECRET bir gun dondurulurse (guvenlik olayi, sizinti,
# rutin rotasyon) saklanmis BUTUN pazaryeri magaza kimlik bilgileri
# kalici olarak cozulemez hale gelir ve her kullanici tum magazalarini
# yeniden baglamak zorunda kalir. Dagitim aninda hicbir uyari vermez.
#
# ⚠️ Uretimde henuz bagli magaza YOK; bu anahtari SIMDI koymak
# bedelsiz, sonra koymak degil (mevcut kayitlar cozulemez olur).
#
# Uret:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=

# ── Zorunlu: veritabani ────────────────────────────────────────────
# Iki AYRI parola. `DB_PASSWORD` sahip rol (gocler icin),
# `APP_DB_PASSWORD` uygulamanin en az yetkili rolu.
DB_PASSWORD=
APP_DB_PASSWORD=

# ── Zorunlu: adresler ──────────────────────────────────────────────
APP_PUBLIC_URL=https://localkarar.com

# Iletisim formundan gelen destek mesajlari buraya duser.
# Tanimsizsa form calismaz ve kullaniciya 503 ile "su anda kullanilamiyor"
# der -- sessizce yutup "gonderildi" DEMEZ.
SUPPORT_MAIL_TO=kvkk@localkarar.com
CORS_ORIGIN=https://localkarar.com

# ── Zorunlu: e-posta ───────────────────────────────────────────────
# Resend → API keys. MAIL_FROM, Resend'de DOGRULANAN alan adiyla ayni
# olmali (mail.localkarar.com), yoksa gonderim reddedilir.
RESEND_API_KEY=
MAIL_FROM="LocalKarar <bildirim@mail.localkarar.com>"

# ── 🔴 Ters vekil ──────────────────────────────────────────────────
# Zincir: Cloudflare → Caddy → Fastify = 2 sicrama.
#
# `true` YAZMA. Olculmustu: kosulsuz guven halinde X-Forwarded-For
# uydurularak 3/saat sinirinda 6/6 istek geciyordu. Sayi vermek,
# yalniz bilinen sicrama kadarini guvenilir sayar.
TRUST_PROXY=2

# ── AI saglayici ───────────────────────────────────────────────────
# LocalKarar container -> sunucu hostundaki OmniRoute OpenAI API.
# Gercek API portunu OmniRoute baslangic ciktisindan dogrulayin. OmniRoute
# ayri container olarak ayni aga eklenirse host.docker.internal yerine
# Docker servis adini kullanin (ornegin http://omniroute:20129/v1).
AI_GATEWAY_ENABLED=false
AI_MENTOR_PROFILE=MENTOR_STANDARD
AI_PROVIDER=omniroute
OMNIROUTE_BASE_URL=http://host.docker.internal:20128/v1
OMNIROUTE_API_KEY=
# Dashboard -> Combos altinda bu sabit isimle Priority combo olusturun.
# Ust modeller panelden degisir; LocalKarar modeli degismez.
OMNIROUTE_MODEL=localkarar-mentor

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731

# OmniRoute primary; Gemini ve NVIDIA dogrudan fallback. Tek satir tutun.
AI_PROVIDER_CANDIDATES_JSON={"MENTOR_STANDARD":[{"enabled":true,"providerId":"omniroute","model":"localkarar-mentor","priority":0,"timeoutMs":20000,"maxRetries":0,"supportsReasoning":false},{"enabled":true,"providerId":"gemini","model":"gemini-3.7-flash","priority":1,"timeoutMs":20000,"maxRetries":1,"supportsReasoning":false},{"enabled":true,"providerId":"nvidia","model":"deepseek-ai/deepseek-v4-flash-0731","priority":2,"timeoutMs":20000,"maxRetries":1,"supportsReasoning":true}]}

# OmniRoute yerel olsa da secilen modeller bulut saglayicilarina gidebilir.
AI_ALLOW_EXTERNAL_PROVIDERS=true

# ── KVKK notlari (aydinlatma metnine girecek) ──────────────────────
# * Mentor sohbetleri Mistral AI (Fransa) sunucularinda islenir.
# * Kotuye kullanim denetimi icin 30 GUN saklanir. Ucretsiz katmanda
#   kapatilamaz (Zero Data Retention yalniz ucretli Scale planinda).
# * EGITIMDE KULLANIM VARSAYILAN OLARAK ACIK. console.mistral.ai ->
#   Privacy -> "Anonymous improvement data" VE API > Privacy ->
#   "Data usage for improving our services" kapatilmali. Ucretsiz.

# ── Yedekleme ──────────────────────────────────────────────────────
# Postgres kapsayicida calistigi ve pg_dump ana makinede olmayabilecegi
# icin betikler kapsayicidaki araclari kullanabiliyor.
PG_DOCKER_CONTAINER=localakademi-postgres
DATABASE_BACKUP_RETENTION_COUNT=14

# ── Ozellik bayraklari ─────────────────────────────────────────────
# Bunlari BOS BIRAKABILIRSIN: deploy/docker-compose.prod.yml icinde
# gelistirme ortamiyla ayni varsayilanlar tanimli. Burada tanimlarsan
# oradaki varsayilani ezersin.
#
# Neden onemli: kod `=== 'true'` karsilastiriyor, yani tanimsiz bayrak
# KAPALI demek. Ilk kurulumda yedisi de kapali kalmisti ve Karar
# Araclari sayfasi "Araclar yuklenemedi" veriyordu (404 FEATURE_DISABLED).
#
# FEATURE_DECISION_CHECKS_ENABLED=true
# FEATURE_LEARNING_PROGRESS_ENABLED=true
# FEATURE_PERSONALIZED_FEED_ENABLED=true
# FEATURE_CONTEXTUAL_MENTOR_ENABLED=true
# FEATURE_LEGACY_QUIZ_ENABLED=false
# FEATURE_LEGACY_FLASHCARDS_ENABLED=false
# FEATURE_PRACTICAL_CARDS_ENABLED=false

# ---------------------------------------------------------------
# GELEN E-POSTA KANALI (Faz E)
# ---------------------------------------------------------------
# Cloudflare Email Worker ile sunucu arasındaki paylaşılan anahtar.
#
# 🔴 BU DEĞİŞKEN YOKSA KANAL TAMAMEN KAPALI: `/inbound/email` ucu HİÇ
# kaydedilmiyor. Boş bir anahtarla açık bırakmak, internete kimliksiz
# bir belge yükleme kapısı açmak olurdu.
#
# En az 32 karakter. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# AYNI değer Cloudflare Worker'ında `INBOUND_SECRET` olarak, "Encrypt"
# işaretli biçimde tanımlanmalı.
INBOUND_MAIL_SECRET=

# ---------------------------------------------------------------
# PayTR sanal POS (basvuru onaylandi 31.08.2026).
#
# Uc deger de PayTR magaza panelinden aliniyor. UCU DE dolu degilse
# odeme akisi KAPALI sayiliyor: /payments/checkout ve
# /payments/paytr/callback 424 PAYMENT_DISABLED doner (503 DEGIL).
#
# 🔴 PAYTR_TEST_MODE VARSAYILANI "true". Gercek tahsilat icin
# bilincli olarak "false" yazilmali. Ters varsayilan secilseydi,
# degisken unutuldugunda ilk dagitim gercek para cekerdi.
#
# 🔴 MAGAZA PANELINE GIRILECEK BILDIRIM URL'SI:
#
#     https://localkarar.com/payments/paytr/callback
#
# Hicbir yerde yaziliyor degildi ve canli geciste unutulmasi, "para
# cekildi ama uyelik acilmadi" arizasinin ta kendisi olurdu: PayTR
# tahsilati yapar, callback hicbir yere ulasmaz.
#
# ⚠️ TRUST_PROXY ACIK OLMALI. Token imzasi istemci IP'sini iceriyor
# (services/payments/routes.ts -> request.ip). Proxy arkasinda yanlis
# IP cozulurse PayTR HER token istegini reddeder ve hata mesaji
# sebebi SOYLEMEZ.
#
# ⚠️ PAYTR_TEST_MODE=false ILE src/config/billing.ts:BILLING_STARTS_AT
# AYNI DAGITIMDA GITMELI. Test kipi kapandigi an admin'in test satin
# alma kapisi da kapanir; BILLING_STARTS_AT hala null ise /checkout
# HERKESE 409 BILLING_NOT_STARTED doner, yani odeme tumden kapanir.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=true
