# LocalKarar — uretim ortam degiskenleri
#
# Sunucuda `.env` olarak kopyala ve doldur. Bu dosya ORNEK; gercek
# degerleri buraya YAZMA, depoya girer.
#
#   cp deploy/env.production.example .env && nano .env

# ── Zorunlu: kimlik ────────────────────────────────────────────────
# Uret:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ── Zorunlu: veritabani ────────────────────────────────────────────
# Iki AYRI parola. `DB_PASSWORD` sahip rol (gocler icin),
# `APP_DB_PASSWORD` uygulamanin en az yetkili rolu.
DB_PASSWORD=
APP_DB_PASSWORD=

# ── Zorunlu: adresler ──────────────────────────────────────────────
APP_PUBLIC_URL=https://localkarar.com
CORS_ORIGIN=https://localkarar.com

# ── Zorunlu: e-posta ───────────────────────────────────────────────
# Resend → API keys. MAIL_FROM, Resend'de DOGRULANAN alan adiyla ayni
# olmali (mail.localkarar.com), yoksa gonderim reddedilir.
RESEND_API_KEY=
MAIL_FROM="LocalKarar <bildirim@mail.localkarar.com>"

# ── 🔴 Ters vekil ──────────────────────────────────────────────────
# Zincir: Cloudflare → Caddy → Fastify = 2 sicrama.
#
# `true` YAZMA. Olculmustu: kosulsuz guven halinde X-Forwarded-For
# uydurularak 3/saat sinirinda 6/6 istek geciyordu. Sayi vermek,
# yalniz bilinen sicrama kadarini guvenilir sayar.
TRUST_PROXY=2

# ── AI saglayici ───────────────────────────────────────────────────
# Varsayilan YOK; acikca verilmeli. Urun karari: yalniz OmniRoute
# ya da yerel Ollama.
AI_PROVIDER=omniroute
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto/best-free

# Yurt disi saglayicilar bilerek kapali.
AI_ALLOW_EXTERNAL_PROVIDERS=false

# ── Yedekleme ──────────────────────────────────────────────────────
# Postgres kapsayicida calistigi ve pg_dump ana makinede olmayabilecegi
# icin betikler kapsayicidaki araclari kullanabiliyor.
PG_DOCKER_CONTAINER=localakademi-postgres
DATABASE_BACKUP_RETENTION_COUNT=14
